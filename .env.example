# Copy to .env (git-ignored), fill in, then load it: set -a; . ./.env; set +a
# The toolkit reads only environment variables. Never commit real keys.
# Nothing here is needed for `oneapi-agent loop --dry-run --mock-tools`.

# --- Which model runs the agent loop ---------------------------------------------
# anthropic | meta | baseten. Default: inferred from the model name (claude-* / muse-*), else anthropic.
# ONEAPI_AGENT_PROVIDER=meta
# Model id. Default: claude-sonnet-5-5 (anthropic), muse-spark-1.3 (meta),
# meta-models/muse-spark-open (baseten).
# ONEAPI_AGENT_MODEL=muse-spark-1.3

# --- Anthropic (Claude) -------------------------------------------------------------
ONEAPI_AGENT_API_KEY=
# ONEAPI_AGENT_BASE_URL=https://api.anthropic.com

# --- Meta Model API (Muse) ---------------------------------------------------------
# Any of these names (first one set wins): ONEAPI_AGENT_META_API_KEY, MODEL_API_KEY, META_API_KEY.
MODEL_API_KEY=
# If a proxy adds the Authorization header for api.meta.ai instead (no key in this process):
# ONEAPI_AGENT_AUTH_FROM_NETWORK=1
# ONEAPI_AGENT_META_BASE_URL=https://api.meta.ai/v1

# --- Muse Spark Open on Baseten (open weights) -------------------------------------
# BASETEN_API_KEY=

# --- Cost cap overrides --------------------------------------------------------------
# Claude and Muse have built-in prices. For any other model set these (USD per million
# tokens); without a price the loop refuses to start, because its USD cap could not apply.
ONEAPI_AGENT_PRICE_IN=
ONEAPI_AGENT_PRICE_OUT=
# ONEAPI_AGENT_PRICE_CACHED_IN=

# --- Rented GPUs for remote-test (only the provider you use) -----------------------
# RUNPOD_API_KEY=
# VAST_API_KEY=
# VULTR_API_KEY=
# OCEAN_API_KEY=            # or DIGITALOCEAN_TOKEN
